# Application Settings
PROJECT_NAME="Cultural Heritage Deterioration Monitoring"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api"

# Database Configuration
# Default SQLite local database
DATABASE_URL="sqlite:///./heritage_monitoring.db"
# Example PostgreSQL migration URL (for future deployment)
# DATABASE_URL="postgresql://user:password@localhost:5432/heritage_db"

# Storage Directories
DATA_DIR="./data"
UPLOAD_DIR="./data/surveys"
OUTPUTS_DIR="./outputs"

# Photogrammetry Settings
COLMAP_PATH="colmap"
USE_MOCK_PHOTOGRAMMETRY=True

# ML Model Settings
USE_MOCK_ML=True
MODEL_DEVICE="cpu"
CONFIDENCE_THRESHOLD=0.60

# Image Quality Thresholds
QUALITY_BLUR_THRESHOLD=100.0
QUALITY_MIN_WIDTH=800
QUALITY_MIN_HEIGHT=600
QUALITY_UNDEREXPOSURE_THRESHOLD=40.0
QUALITY_OVEREXPOSURE_THRESHOLD=220.0
